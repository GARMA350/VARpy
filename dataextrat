#Librerias generales
import requests
import pandas as pd
import numpy as np
import json
import matplotlib.pyplot as plt


def series_bdm(series,nombres_series, startdate, enddate=None, token=None):
    if enddate is None:
        enddate = pd.Timestamp.today().strftime("%Y-%m-%d")
    if token is None:
        token = "431240691f5175f4fa18b3de6ceac375aa4629c2bb931b4febebdd7e43f5b97a"
    if isinstance(series, (list, tuple, set)):
        series_param = ",".join(map(str, series))
    else:
        series_param = str(series).replace("/", ",")

    url = f"https://www.banxico.org.mx/SieAPIRest/service/v1/series/{series_param}/datos/{startdate}/{enddate}"
    headers = {"Bmx-Token": token}

    r = requests.get(url, headers=headers, timeout=30)
    r.raise_for_status()
    data = r.json()

    tablas = []
    nombres = []

    for s in data.get("bmx", {}).get("series", []):
        sid = s.get("idSerie")
        titulo = s.get("titulo", sid)
        df = pd.DataFrame(s.get("datos", []))
        if df.empty:
            continue
        colname = sid
        df = df.rename(columns={"dato": colname})
        df[colname] = (
            df[colname]
            .replace({"N/E": np.nan, "": np.nan})
            .str.replace(",", "", regex=False)
        )
        df["fecha"] = pd.to_datetime(df["fecha"], format="%d/%m/%Y", errors="coerce")
        df[colname] = pd.to_numeric(df[colname], errors="coerce")

        tablas.append(df[["fecha", colname]])
        nombres.append((sid, titulo))

    if not tablas:
        return pd.DataFrame(columns=["fecha"] + (list(series) if isinstance(series, (list, tuple, set)) else [series_param]))

    out = tablas[0]
    for t in tablas[1:]:
        out = out.merge(t, on="fecha", how="outer")


    out["fecha"] = pd.to_datetime(out["fecha"])
    out = out.sort_values("fecha")
    out.attrs["titulos"] = dict(nombres)
    columnasdf = ["Fecha"] + nombres_series
    out.columns = columnasdf
    return out

